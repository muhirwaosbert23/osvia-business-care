# Copy to .env and fill in. Never commit .env.

# --- Server ---
HOST=127.0.0.1
PORT=3080
DATA_DIR=./data
# Public address people use to reach the portal. Used in emails and invitation links.
APP_URL=http://127.0.0.1:3080
# development or production. production refuses to start without HTTPS settings.
NODE_ENV=development
# true only when HTTPS is in front of the portal.
COOKIE_SECURE=false
# true only when a reverse proxy you control sets X-Forwarded-For / X-Forwarded-Host.
TRUST_PROXY=false
SESSION_IDLE_MINUTES=120

# --- Secrets ---
# Encrypts stored two-factor secrets. If empty, a random key is created in DATA_DIR/app-secret.key.
# Changing it later makes existing two-factor enrollments unreadable.
APP_SECRET=
# Encrypts backup files. Leave empty only for local testing.
BACKUP_KEY=
BACKUP_KEEP=14
# Required on the first-run setup page when set. Remove after the administrator exists.
SETUP_TOKEN=

# --- Security ---
# Staff (administrators and technicians) must turn on two-factor authentication.
REQUIRE_STAFF_MFA=true

# --- Contact details shown to customers ---
CONTACT_EMAIL=
CONTACT_PHONE=

# --- Email (SMTP). Without SMTP_HOST and SMTP_FROM, emails are recorded as skipped. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- MeshCentral (optional). See docs/MESHCENTRAL.md and meshcentral/ ---
# Address technicians open in the browser. For the included local server use https://127.0.0.1:4430
MESHCENTRAL_URL=
# WebSocket control address for meshctrl. For the included local server use wss://127.0.0.1:4430
MESHCENTRAL_CONTROL_URL=
# Full path to meshctrl.js. For the included folder: meshcentral/node_modules/meshcentral/meshctrl.js
MESHCTRL_PATH=
# true when the MeshCentral certificate is the local self-signed certificate.
MESHCTRL_TLS_INSECURE=true
MESHCENTRAL_USER=
# Use a login key file (preferred) or a password file. The files stay on the server.
MESHCENTRAL_LOGINKEY_FILE=
MESHCENTRAL_PASSWORD_FILE=
MESHCENTRAL_DOMAIN=
MESH_SYNC_MINUTES=5

# --- Jobs and retention ---
MONITOR_HISTORY_DAYS=90
# true disables background checks, emails, SLA timers and nightly backups.
DISABLE_JOBS=false
